<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cap Bundle end-to-end</title>
</head>
<body>
    {% if result %}<p id="result">{{ result }}</p>{% endif %}
    {% for name, form in forms %}
        <h2>{{ name }}</h2>
        {{ form(form, { attr: { novalidate: 'novalidate' } }) }}
    {% endfor %}
</body>
</html>
