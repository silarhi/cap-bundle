{
    "name": "@silarhi/cap-bundle",
    "description": "Cap CAPTCHA for Symfony forms: the Stimulus controller and the submit handling of silarhi/cap-bundle",
    "version": "0.0.0-development",
    "license": "MIT",
    "author": "SILARHI <dev@silarhi.fr>",
    "homepage": "https://cap-bundle.silarhi.dev",
    "keywords": [
        "cap",
        "captcha",
        "proof-of-work",
        "stimulus",
        "symfony-ux",
        "turbo"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/silarhi/cap-bundle.git",
        "directory": "assets"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./controller": {
            "types": "./dist/controller.d.ts",
            "import": "./dist/controller.js"
        },
        "./live": {
            "types": "./dist/live.d.ts",
            "import": "./dist/live.js"
        },
        "./turbo": {
            "types": "./dist/turbo.d.ts",
            "import": "./dist/turbo.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "symfony": {
        "controllers": {
            "cap": {
                "main": "dist/controller.js",
                "fetch": "lazy",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0"
        }
    },
    "scripts": {
        "build": "tsdown && node scripts/copy-widget.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "biome check src test e2e scripts playwright.config.ts",
        "lint:fix": "biome check --write src test e2e scripts playwright.config.ts",
        "e2e": "playwright test"
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "@hotwired/stimulus": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@cap.js/wasm": "^0.0.8",
        "@hotwired/stimulus": "^3.2.2",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.0.0",
        "@vitest/coverage-v8": "^5.0.5",
        "cap-widget": "^0.1.58",
        "jsdom": "^30.0.0",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.0"
    },
    "packageManager": "pnpm@12.15.0"
}
