{
    "name": "silarhi/cap-bundle",
    "description": "Cap CAPTCHA (trycap.dev) for Symfony forms: a self-hosted, proof-of-work reCAPTCHA alternative with a form type, a validator constraint and a Turbo-ready widget",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "cap",
        "cap-captcha",
        "captcha",
        "captcha-alternative",
        "proof-of-work",
        "recaptcha",
        "symfony",
        "symfony-bundle",
        "symfony-form",
        "symfony-ux",
        "trycap",
        "turbo",
        "stimulus"
    ],
    "authors": [
        {
            "name": "SILARHI",
            "email": "dev@silarhi.fr"
        }
    ],
    "homepage": "https://cap-bundle.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/cap-bundle/issues",
        "source": "https://github.com/silarhi/cap-bundle",
        "docs": "https://cap-bundle.silarhi.dev"
    },
    "require": {
        "php": ">=8.2",
        "php-http/discovery": "^1.20.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-client": "^1.0.3",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/options-resolver": "^6.4 || ^7.0 || ^8.0",
        "symfony/service-contracts": "^2.5 || ^3.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.58.0",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "nyholm/psr7": "^1.8.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-strict-rules": "^2.1.2",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^11.5.57 || ^12.5.38 || ^13.4.1",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "rector/rector": "^2.9.2",
        "symfony/asset": "^6.4 || ^7.0 || ^8.0",
        "symfony/asset-mapper": "^6.4 || ^7.0 || ^8.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0",
        "symfony/error-handler": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/stopwatch": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "conflict": {
        "symfony/config": "<6.4",
        "symfony/dependency-injection": "<6.4",
        "symfony/http-kernel": "<6.4"
    },
    "suggest": {
        "psr/log": "Logs when the Cap server cannot be reached or answers an error (CapVerifier, given a logger)",
        "symfony/asset": "Versions the URL of the bundle's script (bundles/silarhicap/cap.js) like your other assets",
        "symfony/framework-bundle": "Register Silarhi\\CapBundle\\SilarhiCapBundle for zero-config service wiring (optional: without it, build CapVerifier, CapValidator and CapType by hand, without symfony/dependency-injection nor symfony/http-kernel)",
        "symfony/http-client": "Provides Symfony's psr18.http_client, the default HTTP client calling /siteverify, unless cap.http_client is set",
        "symfony/translation": "Translates the validation messages, which are translation keys (cap.validation.*)",
        "symfony/twig-bundle": "Renders the CapType widget: the bundle adds its form theme to twig.form_themes"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\CapBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\CapBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "bump:tools": "@composer bump ergebnis/composer-normalize friendsofphp/php-cs-fixer phpstan/* phpunit/phpunit rector/rector",
        "test": "phpunit"
    }
}
